{
  "name": "nova",
  "version": "1.0.0",
  "private": true,
  "description": "N\u00d8VA \u2014 Private Proof Network. Selective-disclosure credentials and proofs of eligibility on Midnight.",
  "author": "N\u00d8VA",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "workspaces": [
    "contract"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --workspace=nova-contract && next build",
    "start": "next start",
    "lint": "eslint src contract/src",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=nova-contract",
    "test": "npm run test --workspaces --if-present",
    "contract": "npm run compact --workspace=nova-contract",
    "wallet:init": "tsx scripts/init-deploy-wallet.ts",
    "wallet:check": "tsx scripts/check-wallet.ts",
    "deploy:ledger": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/deploy-ledger.ts",
    "deploy:sync": "tsx scripts/sync-chunks.ts",
    "deploy:heal": "tsx scripts/heal-dust-cursor.ts",
    "deploy:verify": "tsx scripts/verify-deployment.ts",
    "deploy:supervised": "scripts/supervise-deploy.sh"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/fiber": "^9.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.2",
    "lucide-react": "^1.33.0",
    "next": "^15.5.23",
    "nova-contract": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.182.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.182.0",
    "@types/ws": "^8.18.0",
    "axios": "1.20.0",
    "eslint": "^9.39.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "ws": "^8.21.0"
  }
}