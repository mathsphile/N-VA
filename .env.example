# ---------------------------------------------------------------------------
# NØVA environment configuration
# Copy to .env.local. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Midnight ledger mode --------------------------------------------------
# Leave unset (or "simulation") to run NØVA against the local proof engine.
# Set to "ledger" to bind proofs to a published NØVA Compact contract.
NEXT_PUBLIC_MIDNIGHT_MODE=simulation
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preprod
NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
NEXT_PUBLIC_MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ID=

# Server-side deploy/funding seed for `npm run deploy:ledger` ONLY.
# Never exposed to the browser. Use a throwaway testnet wallet.
# Per-network overrides take precedence: MIDNIGHT_PREVIEW_SEED /
# MIDNIGHT_PREPROD_SEED. Generate one with `npm run wallet:init preview`.
MIDNIGHT_WALLET_SEED=
MIDNIGHT_PREVIEW_SEED=

# Local proof server (sidecar) used when NEXT_PUBLIC_MIDNIGHT_MODE=ledger
PROOF_SERVER_URL=http://localhost:6300

# --- Policy engine (optional) ----------------------------------------------
# Qwen via an OpenAI-compatible endpoint. When unset, the deterministic
# local rule parser handles policy compilation.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
